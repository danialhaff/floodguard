# FloodGuard Environment Configuration
# Optional: PostgreSQL / Supabase connection URL. If omitted or unreachable, FloodGuard automatically falls back to local SQLite.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional: OpenWeatherMap API key for live weather data in Taman Sri Muda
# OPENWEATHER_API_KEY=your_openweather_api_key_here
